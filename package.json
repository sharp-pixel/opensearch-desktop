{
  "name": "opensearch-notebook-ui",
  "private": true,
  "version": "0.0.1",
  "description": "OpenSearch Developer Workbench - Query notebook and security role generator",
  "author": "OpenSearch Contributors",
  "license": "Apache-2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run licenses:check && tsc -b && vite build && node scripts/license-notices.mjs --bundle",
    "lint": "npm run lint:licenses && npm run licenses:check && eslint .",
    "lint:licenses": "node scripts/check-license-headers.mjs",
    "licenses:generate": "node scripts/license-notices.mjs --generate",
    "licenses:check": "node scripts/license-notices.mjs --check",
    "preview": "vite preview",
    "test": "vitest --run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:mac": "npm run build && electron-builder --mac --arm64",
    "electron:build:mac:x64": "npm run build && electron-builder --mac --x64",
    "electron:build:mac:universal": "npm run build && electron-builder --mac --universal",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "release:prepare": "node scripts/prepare-updater-config.mjs",
    "release:version": "node scripts/set-release-version.mjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.5",
    "@monaco-editor/react": "4.7.0",
    "d3": "7.9.0",
    "dompurify": "3.4.16",
    "js-yaml": "5.4.2",
    "katex": "0.18.9",
    "marked": "18.0.14",
    "marked-katex-extension": "5.1.13",
    "papaparse": "5.7.0",
    "protobufjs": "8.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.5",
    "@types/d3": "7.4.3",
    "@types/katex": "0.16.8",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "concurrently": "10.0.5",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "jsdom": "30.1.1",
    "monaco-editor": "0.57.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wait-on": "9.1.0"
  },
  "overrides": {
    "tar": "7.5.22",
    "app-builder-lib": {
      "@electron/asar": "4.3.1",
      "@electron/get": "5.1.0",
      "@electron/universal": "3.0.6"
    }
  },
  "build": {
    "appId": "com.opensearch.developer-workbench",
    "productName": "OpenSearch Developer Workbench",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "compression": "maximum",
    "afterExtract": "scripts/preserve-electron-licenses.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/node/**/*"
    ],
    "extraResources": [
      { "from": "licenses/distribution", "to": "licenses" }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "src-tauri/icons/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src-tauri/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "src-tauri/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
