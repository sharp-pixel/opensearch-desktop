{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenSearch Developer Workbench",
  "version": "0.0.1",
  "identifier": "com.opensearch.developer-workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenSearch Developer Workbench",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../licenses/distribution/": "licenses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "shell": {
      "open": "^https?://[^\\s]+$"
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
